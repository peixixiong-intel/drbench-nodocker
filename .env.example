# Copy this file to `.env` and fill in your key.  (.env is git-ignored.)

# Required: OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model overrides (defaults shown).
# AGENT_MODEL writes the report; JUDGE_MODEL scores it (DRBench's judge is gpt-4o).
# AGENT_MODEL=openai/gpt-4o-mini
# JUDGE_MODEL=openai/gpt-4o

# Optional: corporate proxy. On the office network a direct OpenRouter call may
# time out; point these at the proxy and requests will use it automatically.
# HTTPS_PROXY=http://proxy-dmz.intel.com:912
# HTTP_PROXY=http://proxy-dmz.intel.com:912
